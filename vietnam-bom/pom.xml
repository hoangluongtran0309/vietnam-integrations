<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Intentionally NOT inheriting vietnam-integrations-parent:
       otherwise importing this BOM would also import the whole Spring Boot BOM. See docs/adr/0003. -->
  <groupId>io.github.hoangluongtran0309</groupId>
  <artifactId>vietnam-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Vietnam Integrations BOM</name>
  <description>Bill of materials for Vietnam Integrations.</description>
  <url>https://github.com/hoangluongtran0309/vietnam-integrations</url>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>hoangluongtran0309</id>
      <name>Hoang Luong Tran</name>
      <url>https://hoangluongtran.dev</url>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/hoangluongtran0309/vietnam-integrations</url>
    <connection>scm:git:https://github.com/hoangluongtran0309/vietnam-integrations.git</connection>
  </scm>

  <dependencyManagement>
    <dependencies>
      <dependency><groupId>io.github.hoangluongtran0309</groupId><artifactId>vietnam-vietqr-core</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.github.hoangluongtran0309</groupId><artifactId>vietnam-vietqr-spring-boot-starter</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.github.hoangluongtran0309</groupId><artifactId>vietnam-zalo-oa-core</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.github.hoangluongtran0309</groupId><artifactId>vietnam-zalo-oa-spring-boot-starter</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.github.hoangluongtran0309</groupId><artifactId>vietnam-einvoice-core</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.github.hoangluongtran0309</groupId><artifactId>vietnam-einvoice-spring-boot-starter</artifactId><version>${project.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <!-- The BOM does not inherit the parent, so it needs its own release profile.
       Keep plugin versions and configuration in sync with the parent pom.xml. -->
  <properties>
    <central-publishing.version>0.11.0</central-publishing.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
  </properties>

  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
            <configuration>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <!-- Return once Central has validated the bundle; publishing then completes on its own and can
                   take longer than the plugin's polling timeout. -->
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
